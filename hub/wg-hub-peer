#!/usr/bin/env bash
# wg-hub-peer — manage peers on the hub. Installed to /usr/local/sbin, run as root.
set -euo pipefail

WG_DIR="${WG_DIR:-/etc/wireguard}"
CONF="$WG_DIR/wg0.conf"
RULES="$WG_DIR/isolate.rules"
SUBNET_PREFIX="10.66.66."

die() {
  echo "wg-hub-peer: $*" >&2
  exit 1
}

valid_name() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || die "invalid name: $1"; }
valid_key() { [[ "$1" =~ ^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$ ]] || die "invalid public key"; }
valid_ip() {
  [[ "$1" =~ ^10\.66\.66\.([0-9]{1,3})$ ]] || die "IP must be in ${SUBNET_PREFIX}0/24: $1"
  local n="${BASH_REMATCH[1]}"
  if [ "$n" -lt 2 ] || [ "$n" -gt 254 ]; then die "IP out of range: $1"; fi
}

# peers — print "name pubkey ip" for each managed peer.
peers() {
  awk '
    /^\[/ { if (name != "") print name, key, ip; name = key = ip = "" }
    /^# wg-hub: / { name = $3 }
    /^PublicKey = / { key = $3 }
    /^AllowedIPs = / { ip = $3; sub(/\/32$/, "", ip) }
    END { if (name != "") print name, key, ip }
  ' "$CONF"
}

cmd_add() {
  [ $# -eq 3 ] || die "usage: add NAME PUBKEY IP"
  local name="$1" key="$2" ip="$3"
  valid_name "$name"
  valid_key "$key"
  valid_ip "$ip"
  peers | awk -v n="$name" '$1 == n { f = 1 } END { exit !f }' && die "peer '$name' already exists"
  peers | awk -v i="$ip" '$3 == i { f = 1 } END { exit !f }' && die "IP $ip is already in use"
  wg set wg0 peer "$key" allowed-ips "$ip/32"
  printf '\n[Peer]\n# wg-hub: %s\nPublicKey = %s\nAllowedIPs = %s/32\n' "$name" "$key" "$ip" >>"$CONF"
}

cmd_remove() {
  [ $# -eq 1 ] || die "usage: remove NAME"
  local name="$1" key tmp
  valid_name "$name"
  key="$(peers | awk -v n="$name" '$1 == n { print $2 }')"
  [ -n "$key" ] || die "No peer named '$name'"
  wg set wg0 peer "$key" remove
  tmp="$(mktemp "$WG_DIR/.wg0.XXXXXX")"
  awk -v marker="# wg-hub: $name" '
    function flush() { if (!drop) printf "%s", buf; buf = ""; drop = 0 }
    /^\[/ { flush() }
    $0 == marker { drop = 1 }
    { buf = buf $0 "\n" }
    END { flush() }
  ' "$CONF" >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$CONF"
}

cmd_used_ips() { peers | awk '{ print $3 }'; }

cmd_list() {
  local hs
  hs="$(wg show wg0 latest-handshakes 2>/dev/null || true)"
  peers | while read -r name key ip; do
    local t
    t="$(printf '%s\n' "$hs" | awk -v k="$key" '$1 == k { print $2 }')"
    echo "$name $ip ${t:-0}"
  done
}

apply_rule() {
  local action="$1" a="$2" b="$3" src dst
  for pair in "$a $b" "$b $a"; do
    read -r src dst <<<"$pair"
    local rule=(FORWARD -i wg0 -s "$src" -d "$dst" -j REJECT)
    if [ "$action" = up ]; then
      iptables -C "${rule[@]}" 2>/dev/null || iptables -I "${rule[@]}"
    else
      iptables -D "${rule[@]}" 2>/dev/null || true
    fi
  done
}

cmd_apply_isolation() {
  local action="${1:-up}" a b
  [ "$action" = up ] || [ "$action" = down ] || die "usage: apply-isolation up|down"
  [ -f "$RULES" ] || return 0
  while read -r a b; do
    [ -n "$a" ] && apply_rule "$action" "$a" "$b"
  done <"$RULES"
}

cmd_isolate() {
  [ $# -eq 2 ] || die "usage: isolate IP_A IP_B"
  valid_ip "$1"
  valid_ip "$2"
  [ "$1" != "$2" ] || die "cannot isolate a peer from itself"
  touch "$RULES"
  grep -qxF "$1 $2" "$RULES" || grep -qxF "$2 $1" "$RULES" || echo "$1 $2" >>"$RULES"
  apply_rule up "$1" "$2"
}

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    list) cmd_list ;;
    used-ips) cmd_used_ips ;;
    isolate) cmd_isolate "$@" ;;
    apply-isolation) cmd_apply_isolation "$@" ;;
    *) die "usage: wg-hub-peer {add|remove|list|used-ips|isolate|apply-isolation}" ;;
  esac
}

main "$@"
